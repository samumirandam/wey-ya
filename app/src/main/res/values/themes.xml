<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WeyYa" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/weyya_orange</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.WeyYa.Main</item>
    </style>
    <style name="Theme.WeyYa.Main" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Draw into the display cutout (replaces the SHORT_EDGES that enableEdgeToEdge() set in
             code). The theme attribute is not a deprecated API, so Play Console does not flag it. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
